doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="description" content="domaincentric.commerce — A curated collection of premium products, delivered with care.")
    title= title || "domaincentric.commerce"
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Sans:wght@400..700&family=Inter:wght@300..700&family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Nunito+Sans:ital,wght@0,300..700;1,300..700&family=Space+Grotesk:wght@400..700&display=swap")
    link(rel="stylesheet" href="/css/main.css")
    script.
      (function(){var t=localStorage.getItem('dca-theme');if(t&&t!=='blueprint')document.documentElement.setAttribute('data-theme',t)})();
    noscript
      link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Sans:wght@400..700&family=Inter:wght@300..700&family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Nunito+Sans:ital,wght@0,300..700;1,300..700&family=Space+Grotesk:wght@400..700&display=swap")
  body
    .stack-ribbon.stack-ribbon--java(aria-hidden="true" data-test="stack-ribbon")
      span.stack-ribbon__label(title="Java reference implementation — Spring Boot") Java
    header.site-header(data-test="site-header")
      .site-header__inner
        a.site-header__logo(href="/" data-test="site-logo")
          svg.site-header__mark(viewBox="17.4 12 85.2 96" fill="none" aria-hidden="true" focusable="false")
            polygon(points="60,20 94.6,40 94.6,80 60,100 25.4,80 25.4,40" stroke="currentColor" stroke-width="7" stroke-linejoin="round")
            circle(cx="60" cy="20" r="8" fill="currentColor")
            circle(cx="94.6" cy="40" r="8" fill="currentColor")
            circle(cx="94.6" cy="80" r="8" fill="currentColor")
            circle(cx="60" cy="100" r="8" fill="currentColor")
            circle(cx="25.4" cy="80" r="8" fill="currentColor")
            circle(cx="25.4" cy="40" r="8" fill="currentColor")
            circle.site-header__mark-core(cx="60" cy="60" r="12")
          span.site-header__wordmark
            | domaincentric
            span.brand-tld .commerce
        nav.nav(aria-label="Main navigation")
          ul.nav__list
            li.nav__item
              a.nav__link(href="/" data-test="nav-home-link") Home
            li.nav__item
              a.nav__link(href="/products" data-test="nav-products-link") Products
        .site-header__actions
          if identity != null && !identity.isAnonymous()
            a.nav__link(href="/account" data-test="nav-my-account-link") My Account
          .mini-basket(data-test="mini-basket")
            a.mini-basket__trigger(href="/cart" data-test="mini-basket-trigger")
              span Cart
              if miniBasketItemCount > 0
                span.mini-basket__count(data-test="mini-basket-count")= miniBasketItemCount
            if miniBasketItemCount > 0
              .mini-basket__dropdown(data-test="mini-basket-dropdown")
                each item in miniBasketItems
                  .mini-basket__item
                    span= item.name()
                    span x#{item.quantity()}
                .mini-basket__total
                  span Total
                  span= miniBasketTotal
                a.mini-basket__link.btn.btn--primary.btn--sm(href="/cart" data-test="mini-basket-view-cart-link") View Cart
          if identity != null && !identity.isAnonymous()
            span.nav__link(data-test="user-greeting") Welcome, #{identity.email().orElse('User')}
            form.nav__logout-form(method="post" action="/logout" data-test="logout-form")
              if _csrf
                input(type="hidden" name=_csrf.parameterName value=_csrf.token)
              button.nav__link.nav__logout-btn(type="submit" data-test="logout-button") Logout
          else
            a.nav__link(href="/login" data-test="nav-login-link") Login
            a.nav__link(href="/register" data-test="nav-register-link") Register

    main.site-main
      .container
        if successMessage
          .alert.alert--success(data-test="success-message")= successMessage
        if errorMessage
          .alert.alert--error(data-test="error-message")= errorMessage
        block content

    footer.site-footer(data-test="site-footer")
      .site-footer__inner
        .site-footer__text domaincentric.commerce &mdash; Built with Domain-Centric Architecture
        .site-footer__links
          a.site-footer__link(href="/backoffice/events" data-test="footer-event-log-link") Event Log
        .theme-switcher(data-test="theme-switcher")
          label.theme-switcher__label(for="theme-select") Theme
          select#theme-select.theme-switcher__select(data-test="theme-select")
            option(value="blueprint") Blueprint
            option(value="organic") Organic
            option(value="sharp") Sharp &amp; Minimal
            option(value="classic") Classic
            option(value="vibrant") Neon + Dark
    script.
      (function() {
        var saved = localStorage.getItem('dca-theme');
        if (saved) {
          if (saved !== 'blueprint') document.documentElement.setAttribute('data-theme', saved);
          var sel = document.getElementById('theme-select');
          if (sel) sel.value = saved;
        }
        document.getElementById('theme-select').addEventListener('change', function(e) {
          var theme = e.target.value;
          if (theme === 'blueprint') {
            document.documentElement.removeAttribute('data-theme');
          } else {
            document.documentElement.setAttribute('data-theme', theme);
          }
          localStorage.setItem('dca-theme', theme);
        });
      })();
