extends ../layout

block content
  .confirmation
    .checkout__progress(data-test="checkout-progress")
      .checkout__step.checkout__step--completed
        .checkout__step-marker 1
        .checkout__step-label Buyer Info
      .checkout__step.checkout__step--completed
        .checkout__step-marker 2
        .checkout__step-label Delivery
      .checkout__step.checkout__step--completed
        .checkout__step-marker 3
        .checkout__step-label Payment
      .checkout__step.checkout__step--completed
        .checkout__step-marker 4
        .checkout__step-label Confirmed

    .confirmation__message(data-test="confirmation-message")
      .confirmation__icon
      h3.confirmation__title(data-test="confirmation-title") Your order has been placed successfully
      p.confirmation__reference Order Reference: #[span(data-test="order-reference") #{confirmedCheckout.sessionId()}]

    .confirmation__details
      h3.confirmation__details-title Order Summary

      if confirmedCheckout.buyerInfo()
        .confirmation__detail-section
          h4 Contact Information
          p #{confirmedCheckout.buyerInfo().firstName()} #{confirmedCheckout.buyerInfo().lastName()}
          p #{confirmedCheckout.buyerInfo().email()}
          if confirmedCheckout.buyerInfo().phone()
            p #{confirmedCheckout.buyerInfo().phone()}

      if confirmedCheckout.delivery()
        .confirmation__detail-section
          h4 Delivery Address
          p #{confirmedCheckout.delivery().address().street()}
          if confirmedCheckout.delivery().address().streetLine2()
            p #{confirmedCheckout.delivery().address().streetLine2()}
          p #{confirmedCheckout.delivery().address().city()}, #{confirmedCheckout.delivery().address().postalCode()}
          if confirmedCheckout.delivery().address().state()
            p #{confirmedCheckout.delivery().address().state()}, #{confirmedCheckout.delivery().address().country()}
          else
            p #{confirmedCheckout.delivery().address().country()}

          h4 Shipping Method
          p #{confirmedCheckout.delivery().shippingOption().name()}
          p Estimated Delivery: #{confirmedCheckout.delivery().shippingOption().estimatedDelivery()}

      if confirmedCheckout.payment()
        .confirmation__detail-section
          h4 Payment Method
          p #{confirmedCheckout.payment().providerId()}

      if confirmedCheckout.lineItems() && confirmedCheckout.lineItems().size() > 0
        .confirmation__detail-section
          h4 Items Ordered
          each item in confirmedCheckout.lineItems()
            .order-summary__item
              .order-summary__item-image
                if item.imageUrl()
                  img(src=item.imageUrl() alt=item.productName())
              span.order-summary__item-name #{item.productName()}
              span.order-summary__item-qty x#{item.quantity()}
              span.order-summary__item-price #{item.lineTotal()} #{item.currencyCode()}

      if confirmedCheckout.totals()
        .confirmation__detail-section
          .order-summary__line
            span Subtotal
            span #{confirmedCheckout.totals().subtotal()} #{confirmedCheckout.totals().currencyCode()}
          if confirmedCheckout.totals().shipping()
            .order-summary__line
              span Shipping
              span #{confirmedCheckout.totals().shipping()} #{confirmedCheckout.totals().currencyCode()}
          if confirmedCheckout.totals().tax()
            .order-summary__line
              span Tax
              span #{confirmedCheckout.totals().tax()} #{confirmedCheckout.totals().currencyCode()}
          .order-summary__total
            span Order Total
            span #{confirmedCheckout.totals().total()} #{confirmedCheckout.totals().currencyCode()}

    .confirmation__footer
      a.btn.btn--primary.btn--lg(href="/" data-test="confirmation-continue-link") Continue Shopping
