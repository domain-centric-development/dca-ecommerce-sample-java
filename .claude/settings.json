{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "product-catalog"
  ],
  "permissions": {
    "allow": [
      "Bash(./gradlew build:*)",
      "Bash(./gradlew bootRun --no-daemon)",
      "Bash(./gradlew test-architecture:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew testClasses:*)",
      "Bash(./gradlew test-integration:*)",
      "Bash(./gradlew test-e2e:*)",
      "Bash(./gradlew spotlessApply:*)",
      "Bash(./gradlew spotlessCheck:*)",
      "mcp__product-catalog__all-products",
      "Edit(src/**)",
      "Edit(docs/**)",
      "Edit(scripts/**)",
      "Bash(rm src/**)",
      "Bash(python3 .agents/factory/story-gate.py:*)",
      "Bash(./gradlew:*)",
      "Bash(bash .agents/factory/factory.sh status:*)",
      "Bash(bash .agents/factory/factory.sh decisions:*)",
      "Bash(bash .agents/factory/factory.sh backlog:*)",
      "Bash(bash .agents/factory/factory.sh setup --check:*)",
      "Bash(bash .agents/factory/factory.sh verify:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/factory/story-gate.py --status --brief --session-start"
          }
        ]
      }
    ]
  }
}
