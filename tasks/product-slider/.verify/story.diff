+          var previous = slider.querySelector('[data-product-slider-previous]');
+          var next = slider.querySelector('[data-product-slider-next]');
+          function step() {
+            var cards = track.children;
+            return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
+          }
+          function update() {
+            previous.disabled = track.scrollLeft <= 1;
+            next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
+          }
+          function move(by) {
+            var index = Math.round(track.scrollLeft / step()) + by;
+            track.scrollTo({ left: Math.max(0, index) * step() });
+          }
+          previous.addEventListener('click', function () { move(-1); });
+          next.addEventListener('click', function () { move(1); });
